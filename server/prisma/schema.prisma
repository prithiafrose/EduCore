generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Department {
  id        Int       @id @default(autoincrement())
  name      String
  code      String    @unique
  createdAt DateTime  @default(now())
  programs  Program[]
}

model Program {
  id                Int                @id @default(autoincrement())
  name              String
  code              String             @unique
  durationYears     Int?
  departmentId      Int
  createdAt         DateTime           @default(now())
  totalSemesters    Int?
  programType       String?
  academicSemesters AcademicSemester[]
  fees              Fee[]
  department        Department         @relation(fields: [departmentId], references: [id])
  students          Student[]
}

model AcademicSemester {
  id                  Int                  @id @default(autoincrement())
  name                String
  order               Int
  programId           Int
  createdAt           DateTime             @default(now())
  program             Program              @relation(fields: [programId], references: [id])
  courseOfferings     CourseOffering[]
  courseRegistrations CourseRegistration[]
  fees                Fee[]

  @@unique([programId, order])
}

model Course {
  id              Int              @id @default(autoincrement())
  code            String           @unique
  name            String
  credit          Decimal
  description     String?
  createdAt       DateTime         @default(now())
  courseOfferings CourseOffering[]
}

model Teacher {
  id               Int                 @id @default(autoincrement())
  name             String
  email            String              @unique
  employeeId       String              @unique
  createdAt        DateTime            @default(now())
  userId           Int                 @unique
  assignmentsGiven Assignment[]
  classSessions    ClassSession[]
  user             User                @relation(fields: [userId], references: [id])
  assignments      TeacherAssignment[]
}

model CourseOffering {
  id                 Int                      @id @default(autoincrement())
  courseId           Int
  academicSemesterId Int
  createdAt          DateTime                 @default(now())
  assessments        Assessment[]
  assignments        Assignment[]
  classSessions      ClassSession[]
  academicSemester   AcademicSemester         @relation(fields: [academicSemesterId], references: [id])
  course             Course                   @relation(fields: [courseId], references: [id])
  registrationItems  CourseRegistrationItem[]
  enrollments        Enrollment[]
  exams              Exam[]
  sections           Section[]
  teacherAssignments TeacherAssignment[]
  timetables         Timetable[]

  @@unique([courseId, academicSemesterId])
}

model TeacherAssignment {
  id               Int            @id @default(autoincrement())
  teacherId        Int
  courseOfferingId Int
  sectionId        Int?
  createdAt        DateTime       @default(now())
  courseOffering   CourseOffering @relation(fields: [courseOfferingId], references: [id])
  section          Section?       @relation(fields: [sectionId], references: [id])
  teacher          Teacher        @relation(fields: [teacherId], references: [id])
  timetables       Timetable[]

  @@unique([teacherId, courseOfferingId, sectionId])
}

model Student {
  id                    Int                    @id @default(autoincrement())
  studentId             String                 @unique
  name                  String
  email                 String                 @unique
  programId             Int
  createdAt             DateTime               @default(now())
  userId                Int                    @unique
  assignmentSubmissions AssignmentSubmission[]
  attendances           Attendance[]
  courseRegistrations   CourseRegistration[]
  enrollments           Enrollment[]
  program               Program                @relation(fields: [programId], references: [id])
  user                  User                   @relation(fields: [userId], references: [id])
  payments              StudentPayment[]
}

model Enrollment {
  id               Int            @id @default(autoincrement())
  studentId        Int
  courseOfferingId Int
  sectionId        Int?
  enrolledAt       DateTime       @default(now())
  result           CourseResult?
  courseOffering   CourseOffering @relation(fields: [courseOfferingId], references: [id])
  section          Section?       @relation(fields: [sectionId], references: [id])
  student          Student        @relation(fields: [studentId], references: [id])
  marks            StudentMark[]

  @@unique([studentId, courseOfferingId])
}

model Section {
  id                 Int                 @id @default(autoincrement())
  name               String
  courseOfferingId   Int
  createdAt          DateTime            @default(now())
  classSessions      ClassSession[]
  enrollments        Enrollment[]
  courseOffering     CourseOffering      @relation(fields: [courseOfferingId], references: [id])
  teacherAssignments TeacherAssignment[]
  timetables         Timetable[]

  @@unique([courseOfferingId, name])
}

model Timetable {
  id                  Int               @id @default(autoincrement())
  courseOfferingId    Int
  sectionId           Int?
  teacherAssignmentId Int
  dayOfWeek           Int
  startTime           DateTime
  endTime             DateTime
  room                String?
  createdAt           DateTime          @default(now())
  classSessions       ClassSession[]
  courseOffering      CourseOffering    @relation(fields: [courseOfferingId], references: [id])
  section             Section?          @relation(fields: [sectionId], references: [id])
  teacherAssignment   TeacherAssignment @relation(fields: [teacherAssignmentId], references: [id])
}

model ClassSession {
  id                Int            @id @default(autoincrement())
  courseOfferingId  Int
  sectionId         Int?
  teacherId         Int
  timetableId       Int?
  date              DateTime
  startTime         DateTime
  endTime           DateTime
  status            ClassStatus    @default(SCHEDULED)
  rescheduledFromId Int?           @unique
  room              String?
  createdAt         DateTime       @default(now())
  attendances       Attendance[]
  courseOffering    CourseOffering @relation(fields: [courseOfferingId], references: [id])
  rescheduledFrom   ClassSession?  @relation("RescheduledClass", fields: [rescheduledFromId], references: [id])
  rescheduledTo     ClassSession?  @relation("RescheduledClass")
  section           Section?       @relation(fields: [sectionId], references: [id])
  teacher           Teacher        @relation(fields: [teacherId], references: [id])
  timetable         Timetable?     @relation(fields: [timetableId], references: [id])
}

model Attendance {
  id             Int              @id @default(autoincrement())
  classSessionId Int
  studentId      Int
  status         AttendanceStatus
  markedAt       DateTime         @default(now())
  classSession   ClassSession     @relation(fields: [classSessionId], references: [id])
  student        Student          @relation(fields: [studentId], references: [id])

  @@unique([classSessionId, studentId])
}

model StudentMark {
  id                   Int                @id @default(autoincrement())
  enrollmentId         Int
  marks                Decimal
  createdAt            DateTime           @default(now())
  assessmentActivityId Int
  assessmentActivity   AssessmentActivity @relation(fields: [assessmentActivityId], references: [id])
  enrollment           Enrollment         @relation(fields: [enrollmentId], references: [id])

  @@unique([assessmentActivityId, enrollmentId])
}

model Fee {
  id                 Int              @id @default(autoincrement())
  programId          Int
  academicSemesterId Int
  type               FeeType
  amount             Decimal
  dueDate            DateTime
  description        String?
  createdAt          DateTime         @default(now())
  academicSemester   AcademicSemester @relation(fields: [academicSemesterId], references: [id])
  program            Program          @relation(fields: [programId], references: [id])
  payments           StudentPayment[]

  @@unique([programId, academicSemesterId, type])
}

model StudentPayment {
  id        Int           @id @default(autoincrement())
  studentId Int
  feeId     Int
  amount    Decimal
  status    PaymentStatus @default(PENDING)
  paidAt    DateTime?
  createdAt DateTime      @default(now())
  fee       Fee           @relation(fields: [feeId], references: [id])
  student   Student       @relation(fields: [studentId], references: [id])

  @@unique([studentId, feeId])
}

model User {
  id            Int            @id @default(autoincrement())
  email         String         @unique
  passwordHash  String
  role          UserRole
  createdAt     DateTime       @default(now())
  notifications Notification[]
  student       Student?
  teacher       Teacher?
}

model CourseResult {
  id           Int        @id @default(autoincrement())
  enrollmentId Int        @unique
  totalMarks   Decimal
  grade        Grade
  gradePoint   Decimal
  createdAt    DateTime   @default(now())
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id])
}

model Exam {
  id               Int            @id @default(autoincrement())
  courseOfferingId Int
  type             ExamType
  date             DateTime
  startTime        DateTime
  endTime          DateTime
  room             String?
  createdAt        DateTime       @default(now())
  courseOffering   CourseOffering @relation(fields: [courseOfferingId], references: [id])
}

model Assignment {
  id                   Int                    @id @default(autoincrement())
  courseOfferingId     Int
  teacherId            Int
  title                String
  description          String?
  deadline             DateTime
  createdAt            DateTime               @default(now())
  Assessment           Assessment[]
  assessmentActivities AssessmentActivity[]
  courseOffering       CourseOffering         @relation(fields: [courseOfferingId], references: [id])
  teacher              Teacher                @relation(fields: [teacherId], references: [id])
  submissions          AssignmentSubmission[]
}

model AssignmentSubmission {
  id           Int        @id @default(autoincrement())
  assignmentId Int
  studentId    Int
  submittedAt  DateTime?
  fileUrl      String?
  marks        Decimal?
  feedback     String?
  createdAt    DateTime   @default(now())
  assignment   Assignment @relation(fields: [assignmentId], references: [id])
  student      Student    @relation(fields: [studentId], references: [id])

  @@unique([assignmentId, studentId])
}

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id])
}

model Assessment {
  id               Int                  @id @default(autoincrement())
  courseOfferingId Int
  name             String
  type             AssessmentType
  maxMarks         Decimal
  assessmentDate   DateTime?
  createdAt        DateTime             @default(now())
  assignmentId     Int?
  Assignment       Assignment?          @relation(fields: [assignmentId], references: [id])
  courseOffering   CourseOffering       @relation(fields: [courseOfferingId], references: [id])
  activities       AssessmentActivity[]
}

model AssessmentActivity {
  id           Int           @id @default(autoincrement())
  assessmentId Int
  assignmentId Int?
  name         String
  maxMarks     Decimal
  activityDate DateTime?
  createdAt    DateTime      @default(now())
  assessment   Assessment    @relation(fields: [assessmentId], references: [id])
  assignment   Assignment?   @relation(fields: [assignmentId], references: [id])
  marks        StudentMark[]

  @@unique([assessmentId, name])
}

model CourseRegistration {
  id                 Int                      @id @default(autoincrement())
  studentId          Int
  academicSemesterId Int
  status             RegistrationStatus       @default(PENDING)
  registeredAt       DateTime                 @default(now())
  academicSemester   AcademicSemester         @relation(fields: [academicSemesterId], references: [id])
  student            Student                  @relation(fields: [studentId], references: [id])
  items              CourseRegistrationItem[]

  @@unique([studentId, academicSemesterId])
}

model CourseRegistrationItem {
  id               Int                @id @default(autoincrement())
  registrationId   Int
  courseOfferingId Int
  createdAt        DateTime           @default(now())
  courseOffering   CourseOffering     @relation(fields: [courseOfferingId], references: [id])
  registration     CourseRegistration @relation(fields: [registrationId], references: [id])

  @@unique([registrationId, courseOfferingId])
}

enum ClassStatus {
  SCHEDULED
  FINISHED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

enum AssessmentType {
  ATTENDANCE
  MIDTERM
  EVALUATION
}

enum FeeType {
  SEMESTER
  COURSE_REGISTRATION
  OTHER
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

enum UserRole {
  ADMIN
  TEACHER
  STUDENT
}

enum Grade {
  A_PLUS
  A
  A_MINUS
  B_PLUS
  B
  B_MINUS
  C_PLUS
  C
  C_MINUS
  F
}

enum ExamType {
  MIDTERM_1
  MIDTERM_2
  FINAL
}

enum NotificationType {
  GENERAL
  CLASS_CANCELLED
  CLASS_RESCHEDULED
  CLASS_REMINDER
  ASSIGNMENT
  ASSIGNMENT_DEADLINE
  ASSESSMENT_MARK_PUBLISHED
  RESULT_PUBLISHED
  PAYMENT_DUE
  EXAM_SCHEDULE
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}
