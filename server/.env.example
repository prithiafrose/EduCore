# PostgreSQL connection string (Render / Neon / local)
# Prisma CLI requires the schema query param.
DATABASE_URL="postgresql://user:password@host:5432/educore?schema=public"

# JWT settings
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Port for the web service (Render injects this automatically)
PORT=5000

# CORS: the deployed frontend origin
FRONTEND_URL=http://localhost:5176

# EduCore AI Assistant — OpenAI configuration (backend only)
# Leave OPENAI_API_KEY empty to use the built-in deterministic (non-LLM) replies.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: override the seeded admin credentials (see prisma/seed.js)
SEED_ADMIN_EMAIL=admin@educore.edu
SEED_ADMIN_PASSWORD=Admin@123